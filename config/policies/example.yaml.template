# yaml-language-server: $schema=policy.schema.json
# Example safe-ssh-mcp policy extension.
# Copy this file to a .yaml file in this directory and restart the server.
# Policy files are trusted operator configuration and must not be populated from remote or untrusted sources.
# Every generic command and subcommand must declare mode; handler policies declare handler instead.

systemctl:
  mode: whitelist
  positional_variants:
    - ['(?:list-units|list-unit-files)']
    - args:
        - '(?:status|is-active|is-enabled|is-failed|show|list-dependencies|cat)'
      rest_pattern: '[A-Za-z0-9_.@:-]{1,128}'
      min_rest: 0
      max_rest: 10

journalctl:
  mode: whitelist
  valueless_flags: [--no-pager]
  flags:
    - flag: -u
      value_pattern: '[A-Za-z0-9_.@:-]{1,128}'
    - flag: -n
      value_pattern: '[1-9][0-9]{0,3}'
    - flag: --since
      value_pattern: '(?!-).{1,128}'
    - flag: --until
      value_pattern: '(?!-).{1,128}'
    - flag: -p
      value_pattern: '(?:emerg|alert|crit|err|warning|notice|info|debug|[0-7])'
  require_flags:
    - -n
  positional_variants:
    - []

# Each subcommand owns its flags; nested prefixes delegate to effective policies.
docker:
  mode: whitelist
  valueless_flags: [--help]
  nested_commands:
    - ['exec', '[^-].*']
  subcommands:
    ps:
      mode: whitelist
      valueless_flags: [-a]
      positional_variants:
        - []
    stats:
      mode: whitelist
      valueless_flags: [--no-stream]
      require_flags: [--no-stream]
      positional_variants:
        - []

# List only the flags you need; a missing flag is rejected and can be added later.
# Omitting positional_variants accepts any operands, so restrict them when an
# operand can select modifying behaviour.
check-health:
  mode: whitelist
  valueless_flags: [--verbose]
  positional_variants:
    - []

traceroute:
  mode: whitelist
  flags:
    - flag: -m
      value_pattern: '(?:[1-9]|[12][0-9]|30)'
    - flag: -w
      value_pattern: '[0-9]+(?:\.[0-9]+)?'
    - flag: -q
      value_pattern: '[1-9][0-9]?'
  require_flags:
    - -m
